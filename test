var gr = new GlideRecord('u_imp_alarm_codes');
gr.setLimit(3);
gr.query();
while (gr.next()) {
    var fields = gr.getFields();
    for (var i = 0; i < fields.size(); i++) {
        var f = fields.get(i);
        gs.info('COL >> ' + f.getName() + ' = [' + f.getDisplayValue() + ']');
    }
    gs.info('--- end row ---');
}
