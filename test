er.addQuery('sys_import_set', 'IN',
    'd1eedf15a43e83506d754bdd055189cb,fa43ab15a47e83506d754bdd055189b8,1afb147da4320b506d754bdd05518920');
er.query();
gs.info('=== YOUR ERRORS: ' + er.getRowCount() + ' ===');
