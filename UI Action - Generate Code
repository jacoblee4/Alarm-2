function onClick(g_form) {
    var ga = new GlideAjax('x_banun_bunow_al_0.AlarmCodeAjax');
    ga.addParam('sysparm_name', 'generateUniqueCode');
    ga.getXMLAnswer(function(response) {
        if (!response || response == "ERROR") {
            g_form.addErrorMessage('Could not generate a unique code. Please try again or contact an admin.');
            return;
        }
        g_form.setValue('alarm_code', response);
    });
}
