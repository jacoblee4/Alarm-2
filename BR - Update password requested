after update

Filter Conditions
requested_passwordCHANGESTOtrue^issue_type=alarm_panel^EQ

(function executeRule(current, previous /*null when async*/ ) {

    var gr = new GlideRecord('x_banun_property_0_physical_security_work_order');

    gr.addActiveQuery();
    gr.addQuery('issue_type', 'alarm_panel');
    gr.addQuery('x_banun_bunow_al_0_opened_for', current.getValue('x_banun_bunow_al_0_opened_for'));
    gr.addQuery('requested_password', false);

    // Exclude the current record
    gr.addQuery('sys_id', '!=', current.getUniqueValue());

    gr.query();

    while (gr.next()) {
        gr.setValue('requested_password', true);
        gr.work_notes = 'Password request email was triggered from: ' + current.getValue('number');
        gr.setWorkflow(false);
        gr.update();
    }

})(current, previous);
